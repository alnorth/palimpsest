  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react-dom": "^19.2.7",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
