{
  "name": "@alnorth/palimpsest-hooks",
  "version": "0.3.3",
  "type": "module",
  "description": "React hooks + Context for reading and writing palimpsest data in third-party apps",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
